  "cards": [
    {
      "dot": "emerald",
      "title": "Reference v2 đã qua kiểm kỹ thuật; chưa train",
      "items": [
        "83 hybrid tests và tổng 576 regression tests CPU qua; đã loại các test có optimizer steps.",
        "Restart từ C/D + KV + metadata trong process mới; causality và full/chunk/step/scan parity đã kiểm.",
        "Config hash bao gồm feedback; camera row ID cố định khớp DecoderQuery.view_ids.",
        "Reference v1 và protocol pilot giữ nguyên. Chưa có bằng chứng C/D học được event/configuration."
      ]
    },
    {
      "dot": "violet",
      "title": "Toàn bộ state phải xuất để restart",
      "items": [
        "S = C1,D1,C2,D2 + K1,V1,K2,V2 + metadata; C/D riêng chỉ là mã decoder.",
        "C/D: 16 KiB FP32. Hai KV: 128 KiB BF16. Metadata tensor: 800 byte.",
        "Tổng tensor mỗi stream: 148.256 byte = 144,78125 KiB; cộng header 68 byte và overhead serialization.",
        "KV mỗi tầng: 16 bước gồm bước hiện tại, 16 token/bước; ring được già hóa khi mất snapshot."
      ]
    },
    {
      "dot": "cyan",
      "title": "Scan song song theo tầng",
      "items": [
        "Mỗi cặp C/D cập nhật s_t = A_t s_(t-1) + b_t bằng block 2x2, có C→D và D→C.",
        "Hệ số chỉ đọc input tầng hiện tại; không dùng state trước của chính tầng để tính gate.",
        "Tính attention 1 → scan 1 → mixer → attention 2 → scan 2; không phải một scan cho toàn network.",
        "Mixer nhận cả input và C1,D1 hiện tại; nonlinear readout không ghi đè state affine.",
        "Reference scan là đại số song song theo tầng; window gather và trả T snapshots chưa phải kernel tuyến tính tối ưu."
      ]
    },
    {
      "dot": "emerald",
      "title": "Decoder và bằng chứng event",
      "items": [
        "4 query cross-attention block, width 256, 8 heads, FFN 1024; không đọc KV hay ảnh gốc.",
        "Mỗi query trả tile RGB 8x8: ảnh 256x256 dùng 1024 queries. Head 256→192 và reshape không overlap.",
        "64 C tokens cấp content values; D qua bottleneck 16 chỉ đổi routing/gain. C=0 ⇒ RGB=0.",
        "C-only matched-suffix, lag 64 và can thiệp KV: protocol đánh giá kế tiếp; chưa chạy.",
        "D→configuration và counterfactual: chưa đo; rollout cùng cell phải chạy trước query tương lai.",
        "Nội dung sơ đồ bằng tiếng Việt; các nút điều khiển Viewer dùng bản tiếng Anh dự phòng."
      ]
    }
  ]
